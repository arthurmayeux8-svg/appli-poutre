{
  "expo": {
    "name": "Poutre",
    "slug": "appli-poutre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poutre.appli",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "La poutre se connecte en Bluetooth pour mesurer la force de vos doigts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.poutre.appli"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "La poutre se connecte en Bluetooth pour mesurer la force de vos doigts."
        }
      ]
    ],
    "scheme": "poutre"
  }
}
